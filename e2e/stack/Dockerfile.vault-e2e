# Parachute Vault — E2E harness image. NOT a deployment artifact.
#
# Why this exists rather than reusing `parachute-vault/Dockerfile`:
# that image is Alpine (musl), and whisper.cpp ships its Linux CLIs as
# `whisper-bin-ubuntu-<arch>.tar.gz` — glibc binaries that will not execute
# under musl. An e2e run that needs REAL transcription therefore needs a
# glibc base. Keeping this separate means the harness can diverge (ffmpeg,
# a CLI, a model) without bloating the image people actually deploy.
#
# The vault source is built from a checkout passed as the build context, so
# this image can be built from `main` (the "before" clip) or from a feature
# branch (the "after") with nothing changing but the context path.

ARG BUN_VERSION=1.3
FROM oven/bun:${BUN_VERSION} AS base

# ffmpeg is not optional: the whisper-cpp provider ALWAYS transcodes to
# 16 kHz mono WAV before invoking the CLI, because browser capture is
# webm/opus which neither CLI reads. curl+tar fetch the CLI below.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg curl ca-certificates tar \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production --ignore-scripts

COPY core core
COPY src src
COPY bunfig.toml tsconfig.json ./

# ── whisper.cpp CLI ─────────────────────────────────────────────────────────
# Same asset the vault's own installer uses (`install-whisper-cpp.ts`), so the
# harness exercises the binary operators actually get. Pinned to the version
# the source pins; a drift here would silently test a different engine.
ARG WHISPER_CPP_VERSION=1.9.1
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
      arm64) asset="whisper-bin-ubuntu-arm64.tar.gz" ;; \
      amd64) asset="whisper-bin-ubuntu-x64.tar.gz" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/whisper.tgz \
      "https://github.com/ggml-org/whisper.cpp/releases/download/v${WHISPER_CPP_VERSION}/${asset}"; \
    mkdir -p /opt/whisper && tar -xzf /tmp/whisper.tgz -C /opt/whisper; \
    rm /tmp/whisper.tgz; \
    # The tarball's layout has moved between releases; find the CLI rather
    # than hardcoding a path, and fail loudly if it's absent instead of
    # producing an image that looks fine and reports "not installed" at run time.
    bin="$(find /opt/whisper -type f -name 'whisper-cli' | head -1)"; \
    test -n "$bin" || { echo "whisper-cli not found in tarball" >&2; find /opt/whisper | head -50; exit 1; }; \
    ln -s "$bin" /usr/local/bin/whisper-cli; \
    dirname "$bin" > /opt/whisper/.libdir
    # DO NOT flatten the tarball's shared objects into /usr/local/lib. Two
    # things break when you do: `install` dereferences the versioned symlink
    # chain (libggml.so → .so.0 → .so.0.15.1) into plain files, and ggml
    # discovers its compute backends by scanning the directory its own
    # library lives in — so `libggml-cpu.so` stops being found and every
    # invocation dies with `GGML_ASSERT(device) failed` in
    # ggml_backend_dev_init. Keep the layout, point the loader at it.
ENV LD_LIBRARY_PATH=/opt/whisper/whisper-bin-ubuntu-arm64:/opt/whisper/whisper-bin-ubuntu-x64

# Prove the engine actually runs at BUILD time. Without this the image can
# ship "successfully" and only reveal a dead engine deep inside a test run,
# which reads as a product bug rather than a harness one.
RUN whisper-cli --help >/dev/null 2>&1 || whisper-cli -h >/dev/null 2>&1 || \
      { echo "whisper-cli present but not runnable" >&2; exit 1; }

# ── model ───────────────────────────────────────────────────────────────────
# whisper-tiny.en (74 MB). The fix under test is about whether the capability
# flag agrees with the engine, not about transcription quality, so the
# smallest real model is the honest choice — it keeps the loop to seconds
# while still being a genuine transcription rather than a stub.
ARG MODEL_FILENAME=ggml-tiny.en.bin
ARG MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.en.bin
RUN mkdir -p /parachute/transcription/models \
 && curl -fsSL -o "/parachute/transcription/models/${MODEL_FILENAME}" "${MODEL_URL}" \
 && test -s "/parachute/transcription/models/${MODEL_FILENAME}"

# `whisper-cpp` is the provider under test; naming the model explicitly keeps
# the image from depending on whatever the source's default happens to be.
ENV PARACHUTE_HOME=/parachute \
    PORT=1940 \
    VAULT_BIND=0.0.0.0 \
    TRANSCRIPTION_PROVIDER=whisper-cpp \
    TRANSCRIPTION_MODEL=whisper-tiny.en \
    EMBEDDINGS_ENABLED=false \
    NODE_ENV=production

EXPOSE 1940
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=20 \
  CMD curl -fsS "http://localhost:${PORT:-1940}/health" || exit 1

CMD ["bun", "src/cli.ts", "serve"]
